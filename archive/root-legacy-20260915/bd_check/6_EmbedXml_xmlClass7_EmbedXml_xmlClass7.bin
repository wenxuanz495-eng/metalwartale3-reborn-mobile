<!--  不要出现重复属性，否则会出现bug-->
<!--  工具最后修改时间:Tue Feb 11 23:25:35 GMT+0800 2014-->
<data>
	<father>sub</father>
	<arms index="2" id="elecGun">
		<armsLevel>
			<!--武器属性 -->
			<name>电磁炮</name>    <!-- 武器名称【必备】-->
			<type>电磁炮</type>    <!-- 武器类型【必备】-->
			<attackType>motion</attackType>    <!-- 攻击属性【必备】-->
			<energyUse>20</energyUse>    <!-- 能量消耗【必备】 -->
			<description>利用电磁力(洛仑兹力)，能够在短时间内将导弹提升至极速，对目标造成致命打击。</description>
			<commonLevel>8</commonLevel>
			<mustLevel>3</mustLevel>    <!-- 需要的人物等级-->
			<!-- 攻击时的属性-->
			<recoilValue>6</recoilValue>    <!-- 后坐力(默认为0)-->
			<attackGap>1.4</attackGap>    <!-- 攻击间隔【必备】（单位秒）-->
			<attackDelay>0.2</attackDelay>    <!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->
			<bulletNum>1</bulletNum>    <!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
			<!--<shootNum>1</shootNum>    <!-- 1个攻击间隔内的射击次数（默认值为1）-->
			<!--<shootGap>0</shootGap>    <!-- 射击间隔（单位秒），射击次数大于1才有这个值-->
			<!--<bulletLink>subArms/missile_lv1</bulletLink>    <!--子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->

			<!-- 发出子弹时的位置和角度、速度等属性	-->
			<bulletSpeed>40</bulletSpeed>    <!-- 子弹速度，子弹类型为“bullet”才有这个值-->
			<!--<angleRange>0</angleRange>    <!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
			<!--<bulletTranslation>0</bulletTranslation>    <!-- 子弹偏移（默认为0）-->
			<bulletAngle>0</bulletAngle>    <!--指定子弹发射角度，指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->

			<!-- 子弹固有属性-->
			<bulletType>bullet</bulletType>    <!-- 子弹类型【必备】-->
			<hurt>55</hurt>    <!-- 武器伤害【必备】-->
			<bulletLife>2</bulletLife>    <!-- 子弹寿命（默认值为2）-->
			<!--<gravity>0</gravity>    <!-- 重力系数（默认值为0）-->
			<!--<bulletVra>0</bulletVra>    <!-- 自转速度（默认值为0，标准值30）-->
			<bulletWidth>10</bulletWidth>    <!-- 子弹宽度-->

			<!-- 子弹特殊属性-->
			<!--<followB>0</followB>    <!-- 跟踪敏捷度（默认为0，就是不跟踪，标准值为1）-->
			<!--<bounceNum>0</bounceNum>    <!-- 碰撞到敌人的弹射次数-->
			<!--<floorBounce>0</floorBounce>    <!-- 地面反弹值（默认值为0，0直接消亡，标准值为1）-->
			<!--<backTime>0</backTime>    <!-- 回旋归来时间（默认值为0，0不回旋）-->
			<!--<penetrationB>1</penetrationB>    <!-- 是否能穿透敌人（默认值为0，0不穿透，1穿透）-->
			<!--<beatBack>5</beatBack>    <!-- 击退值（默认值为0，0不击退）-->

			<!-- 图像动画-->
			<imgLabel>elecGun_lv1</imgLabel>    <!-- 武器图像【必备】 -->
			<bulletImgLabel>sub/elecGun_lv1_bullet</bulletImgLabel>    <!-- 子弹图像（默认加后缀_bullet） -->
			<hitImgLabel>bullet/purple_motion</hitImgLabel>    <!-- 子弹图像【必备】 -->
			<!--<smokeImgLabel>sub/missile_bullet_smoke</smokeImgLabel>    <!-- 子弹尾烟效果（默认为空） -->
			<!--<imgLoopTime>0</imgLoopTime>    <!-- 射击动画循环时间（0 不循环），【一般激光才用】，同时值应该和bulletLife一样-->
		</armsLevel>
