<data>
	<father>arms</father>
	<arms index="0"   id="soya">
		<armsLevel>
			<!--武器属性 -->
			<name>小黄豆</name>					<!-- 武器名称【必备】-->
			<specialProperty>无限能源</specialProperty>
			<type>太阳炮</type>					<!-- 武器类型【必备】-->
			<attackType>motion</attackType>    	<!-- 攻击属性【必备】-->
			<energyUse>100</energyUse>    		<!-- 能量总量【必备】 -->
			<energyRate>1</energyRate>    		<!-- 能量回复，每秒恢复几点【必备】 -->
			<commonLevel>6</commonLevel>   		<!-- 普遍等级 -->
			<description>利用能源转换器将太阳能转换成能量球发射出去。</description>
			<!-- 攻击时的属性-->
			<recoilValue>2</recoilValue>    <!-- 后坐力(默认为0)-->
			<attackGap>0.1</attackGap>    <!-- 攻击间隔【必备】（单位秒）-->
			<attackDelay>0</attackDelay>    <!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->
			<bulletNum>1</bulletNum>    <!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
			<shootNum>1</shootNum>    <!-- 1个攻击间隔内的射击次数（默认值为1）-->
			<!--<shootGap>0</shootGap>    <!-- 射击间隔（单位秒），射击次数大于1才有这个值-->
			<!--<bulletLink>subArms/missile_lv1</bulletLink>    <!--子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->

			<!-- 发出子弹时的位置和角度、速度等属性	-->
			<bulletSpeed>70</bulletSpeed>    <!-- 子弹速度，子弹类型为“bullet”才有这个值-->
			<!--<bulletMaxV>40</bulletMaxV>    <!---->
			<!--<bulletMaxVa>0</bulletMaxVa>    <!---->

			<angleRange>1</angleRange>    <!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
			<bulletTranslation>0</bulletTranslation>    <!-- 子弹偏移（默认为0）-->
			<!--<bulletAngle>270</bulletAngle>    <!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
			<!--<tranArr>-10,0,10</tranArr>    <!-- 指定偏移量-->

			<!-- 子弹固有属性-->
			<hurt>6.1</hurt>    <!-- 武器伤害【必备】-->
			<bulletType>bullet</bulletType>    <!-- 子弹类型【必备】-->
			<bulletLife>2</bulletLife>    <!-- 子弹寿命（默认值为2）-->
			<!--<gravity>1</gravity>    <!-- 重力系数（默认值为0）-->
			<bulletVra>0</bulletVra>    <!-- 自转速度（默认值为0，标准值30，-1000代表永远不转方向[一般小黄豆才使用]）-->
			<bulletWidth>7</bulletWidth>    <!-- 子弹宽度-->
			<!-- 子弹特殊属性-->
			<!--<addArr>crit_pro:1,crit_mul:1.5</addArr>    <!-- 自带附魔属性-->
