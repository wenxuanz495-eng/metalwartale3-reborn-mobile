			<attackGap>0.1</attackGap>    <!-- 攻击间隔【必备】（单位秒）-->
			<attackDelay>0</attackDelay>    <!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->
