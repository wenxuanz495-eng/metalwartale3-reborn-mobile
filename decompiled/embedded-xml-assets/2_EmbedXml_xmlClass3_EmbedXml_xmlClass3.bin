			<type>穿梭炮</type>    <!-- 武器类型【必备】-->
			<attackType>motion</attackType>    <!-- 攻击属性【必备】-->
			<specialProperty>穿透，成长型</specialProperty>
			<description>成长型武器。自带5%的射击训练。蛇蝎拥有着神秘诱人的魅力,它诱惑敌人走向灭亡。这把以蛇蝎命名的武器，能够高频发射可以切开任何装甲的分子震动刀，轻易切割并且穿透敌人。</description>
			<!-- 能量需求 -->
			<reduceRa>0.7</reduceRa>
			<energyUse>24</energyUse>
			<energyRate>0.025</energyRate>
			<price>100000</price>    <!-- 价格 -->
			<Mprice>1</Mprice>
			<angleRange>9</angleRange>
			<commonLevel>25</commonLevel>    <!-- 普遍等级 -->
			<!-- 合成条件-->
			<mustLevel>1</mustLevel>    <!-- 需要的人物等级-->
			<mustItems>superalloy_num1250,superalloy_Z_num300,superalloy_X_num150,superalloy_Y_num75</mustItems>
			<priceLevel>20</priceLevel>    <!-- 销售等级 -->

			<!-- 攻击时的属性-->
			<recoilValue>4</recoilValue>    <!-- 后坐力(默认为0)-->
			<attackGap>0</attackGap>    <!-- 攻击间隔【必备】（单位秒）-->
			<attackDelay>0</attackDelay>    <!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->
			<bulletNum>1</bulletNum>    <!-- 射击一次的子弹数量（默认值为1），一般用于散射-->

