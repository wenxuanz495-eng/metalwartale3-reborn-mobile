			<bulletType>bullet</bulletType>    <!-- 子弹类型【必备】-->
			<bulletLife>2</bulletLife>    <!-- 子弹寿命（默认值为2）-->
			<bulletWidth>10</bulletWidth>    <!-- 子弹宽度-->

