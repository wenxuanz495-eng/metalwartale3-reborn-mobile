			<description>武器主人：爱の：-D甜心。用修罗之血，凯撒之泪以及两人的灵魂在冥界和天堂的交接点用外道魔像十尾用轮回之眼淬炼制成，它有光明与黑暗，有和平有战争，有理想有腐败。有着极大的杀伤力和穿透力，只要它出现在战场上，世界末日也已经不远。</description>
			<!-- 能量需求 -->
			<reduceRa>1</reduceRa>
			<energyUse>24</energyUse>
			<energyRate>0.025</energyRate>
			<price>100000</price>    <!-- 价格 -->
			<Mprice>12</Mprice>

			<commonLevel>180</commonLevel>    <!-- 普遍等级 -->
			<!-- 合成条件-->
			<mustLevel>50</mustLevel>    <!-- 需要的人物等级-->


