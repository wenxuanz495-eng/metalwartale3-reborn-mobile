			<bulletLife>2</bulletLife>				<!-- 子弹寿命（默认值为2）-->
			<bulletWidth>20</bulletWidth>			<!-- 子弹宽度-->
			
			<!-- 特有属性-->
			<specialType>Proton_Impact</specialType>

			<!-- 图像动画-->
			<imgLabel>tongbuzhizipao_lv1</imgLabel>											<!-- 武器图像【必备】，和子弹图像不同，前面不加 arms/，默认为arms/-->
			<bulletImgLabel>arms/tongbuzhizipao_lv1_bullet</bulletImgLabel>					<!-- 子弹图像（默认加后缀_bullet） -->
			<hitImgLabel>bullet/blue_energy</hitImgLabel>							<!-- 子弹图像【必备】 -->
		</armsLevel>
	</arms>
</data>
