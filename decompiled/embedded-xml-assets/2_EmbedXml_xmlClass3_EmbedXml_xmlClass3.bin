			<!--<crit_mul>0</crit_mul>    <!---->

			<!-- 子弹特殊属性-->
			<!--<followB>0</followB>    <!-- 跟踪敏捷度（默认为0，就是不跟踪，标准值为1）-->
			<!--<followDelay>0</followDelay>    <!---->
			<!--<followMaxTime>0</followMaxTime>    <!---->
			<!--<lightning>0.3</lightning>    <!---->
			<!--<bounceNum>2</bounceNum>    <!--碰撞到敌人的弹射次数-->
			<!--<floorBounce>-1</floorBounce>    <!--地面反弹值（默认值为0，0直接消亡，标准值为1，负数为停止运动不消亡）-->
			<!--<backTime>0</backTime>    <!-- 回旋归来时间（默认值为0，0不回旋）-->
			<!--<penetrationB>0</penetrationB>    <!-- 是否能穿透敌人（默认值为0，0不穿透，1穿透）-->
