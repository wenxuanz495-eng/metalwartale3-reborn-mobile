								<name>布雷</name><!-- 武器名称【必备】-->
								<shootPoint>0,-10</shootPoint>		<!-- 射击点-->
								<type>太阳炮</type>					<!-- 武器类型【必备】-->
								<attackType>boom</attackType>		<!-- 攻击属性【必备】-->	
								
								<!-- 攻击时的属性-->
								<recoilValue>6</recoilValue>		<!-- 后坐力(默认为0)-->
								<attackGap>0.8</attackGap>			<!-- 攻击间隔【必备】（单位秒）-->
								<attackDelay>0.4</attackDelay>		<!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->	
								<bulletNum>1</bulletNum>				<!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
								<shootNum>1</shootNum>				<!-- 1个攻击间隔内的射击次数（默认值为1）-->
								<shootGap>0.25</shootGap>				<!-- 射击间隔（单位秒），射击次数大于1才有这个值-->	
								
								
								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>15</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<bulletTranslation>0</bulletTranslation>
								<angleRange>20</angleRange>			<!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
