								<bulletNum>1</bulletNum>				<!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
								<shootNum>4</shootNum>				<!-- 1个攻击间隔内的射击次数（默认值为1）-->
								<shootGap>0.1</shootGap>				<!-- 射击间隔（单位秒），射击次数大于1才有这个值-->	
								<!--<bulletLink index="2">subArms/missile_lv1</bulletLink>	 子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->
								
								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>15</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<angleRange>10</angleRange>			<!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
								<!-- <bulletTranslation>0</bulletTranslation><!-- 子弹偏移（默认为0）-->
								<bulletAngle>0</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
								<bulletVra>-1000</bulletVra>
								
