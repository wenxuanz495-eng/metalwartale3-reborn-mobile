								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>3</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<bulletMaxV>30</bulletMaxV>
								<bulletMaxVa>20</bulletMaxVa>
								<angleRange>160</angleRange>			<!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
								<!-- <bulletTranslation>0</bulletTranslation><!-- 子弹偏移（默认为0）-->
								<bulletAngle>270</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
								<bulletVra>-1000</bulletVra>
								
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<hurt>0.3</hurt>								<!-- 武器伤害【必备】-->
								<bulletLife>3</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>5</bulletWidth>			<!-- 子弹宽度-->
								<followB>0.7</followB>						<!-- 跟踪敏捷度（默认为0，就是不跟踪，标准值为1）-->
								<followDelay>0.3</followDelay>
								<followMaxTime>2</followMaxTime>
								<!-- 图像动画-->
								<bulletImgLabel>Tracker2/bullet</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
