								<bulletAngle>-25</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<hurt>2</hurt>								<!-- 武器伤害【必备】-->
								<bulletLife>5</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>15</bulletWidth>			<!-- 子弹宽度-->
								<gravity>1</gravity>
								<floorBounce>-1</floorBounce>
								<bulletVra>5</bulletVra>
								<selfBoom>2</selfBoom>	
								<!-- 图像动画-->
								<bulletImgLabel>sub/mines_bullet</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
