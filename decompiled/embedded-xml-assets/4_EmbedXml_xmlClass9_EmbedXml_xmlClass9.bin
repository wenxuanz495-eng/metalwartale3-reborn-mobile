<?xml version="1.0" encoding="utf-8" ?>
<data>
	<arms index="10000"     id="AirLaserFort">
				<armsLevel>
						<name>自动浮游激光炮的武器</name><!-- 武器名称【必备】-->
						<shootPoint>0,4</shootPoint>			<!-- 射击点-->
						<attackType>energy</attackType>		<!-- 攻击属性-->
						<hurt>1</hurt>								<!-- 武器伤害-->
						<levelGrow>2</levelGrow>
						<bulletLife>0.001</bulletLife>					<!-- 子弹寿命（默认值为2）-->
						<bulletType>laser</bulletType>			<!-- 子弹类型-->
						<bulletAngle>90</bulletAngle>					<!-- 指定发射角度（角度值），laser才使用-->
						<bulletWidth>10</bulletWidth>					<!-- 子弹宽度-->
						<penetrationB>1</penetrationB>
						<attackDelay>0.05</attackDelay>		<!-- 攻击前延迟（单位秒），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->
						<hitImgLabel>sub/energy_hit_effect</hitImgLabel>
				</armsLevel>
	</arms>
	<arms index="10001"     id="AirLaserFort_2">
				<armsLevel>
								<!--武器属性 -->
								<name>自动浮游激光炮的武器2</name><!-- 武器名称【必备】-->
								<shootPoint>0,14</shootPoint>		<!-- 射击点-->
								<type>太阳炮</type>					<!-- 武器类型【必备】-->
								<attackType>energy</attackType>		<!-- 攻击属性【必备】-->	
								<energyUse>0</energyUse>			<!-- 能量消耗【必备】 -->
								<description>利用能源转换器将太阳能转换成能量球发射出去。</description>
								
								<!-- 攻击时的属性-->
								<recoilValue>0</recoilValue>		<!-- 后坐力(默认为0)-->
								<attackGap>0.25</attackGap>			<!-- 攻击间隔【必备】（单位秒）-->
								<attackDelay>0</attackDelay>		<!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->	
								<bulletNum>1</bulletNum>				<!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
								<shootNum>2</shootNum>				<!-- 1个攻击间隔内的射击次数（默认值为1）-->
								<shootGap>0.07</shootGap>				<!-- 射击间隔（单位秒），射击次数大于1才有这个值-->	
								<tranArr>-5,5</tranArr>
								<!--<bulletLink index="2">subArms/missile_lv1</bulletLink>	 子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->
								
								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>25</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<angleRange>0</angleRange>			<!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
								<!-- <bulletTranslation>0</bulletTranslation><!-- 子弹偏移（默认为0）-->
								<bulletAngle>90</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
									
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<hurt>0.88</hurt>								<!-- 武器伤害【必备】-->
								<levelGrow>3</levelGrow>
								<bulletLife>2</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>7</bulletWidth>			<!-- 子弹宽度-->
									
								<!-- 图像动画-->
								<bulletImgLabel>AirLaserFort_2/bullet</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
								<hitImgLabel>sub/energy_hit_effect</hitImgLabel><!-- 子弹图像【必备】 -->
								<unitImgLabel>shoot</unitImgLabel><!-- 单位要播放的动画-->
							
				</armsLevel>
	</arms>
	<arms index="10002"     id="SkyPatrol">
				<armsLevel>
								<!--武器属性 -->
								<name>自动浮游激光炮的武器2</name><!-- 武器名称【必备】-->
								<shootPoint>44,32</shootPoint>		<!-- 射击点-->
								<type>太阳炮</type>					<!-- 武器类型【必备】-->
								<attackType>boom</attackType>		<!-- 攻击属性【必备】-->	
								<energyUse>0</energyUse>			<!-- 能量消耗【必备】 -->
								<description>利用能源转换器将太阳能转换成能量球发射出去。</description>
								
								<!-- 攻击时的属性-->
								<recoilValue>0</recoilValue>		<!-- 后坐力(默认为0)-->
								<attackGap>0.5</attackGap>			<!-- 攻击间隔【必备】（单位秒）-->
								<attackDelay>0.35</attackDelay>		<!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->	
								<bulletNum>1</bulletNum>				<!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
								
								<!--<bulletLink index="2">subArms/missile_lv1</bulletLink>	 子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->
								
								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>25</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<!-- <bulletTranslation>0</bulletTranslation><!-- 子弹偏移（默认为0）-->
								<bulletAngle>45</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
									
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<hurt>0.88</hurt>								<!-- 武器伤害【必备】-->
								
								<bulletLife>2</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>7</bulletWidth>			<!-- 子弹宽度-->
									
								<!-- 图像动画-->
								<bulletImgLabel>SkyPatrol/bullet</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
								<hitImgLabel>sub/energy_hit_effect</hitImgLabel><!-- 子弹图像【必备】 -->
								<unitImgLabel>shoot</unitImgLabel><!-- 单位要播放的动画-->
							
				</armsLevel>
	</arms>
	<arms index="10003"     id="ElectricSaw2">
				<armsLevel>
								<!--武器属性 -->
								<name>飞锯机器人-发射钻机</name><!-- 武器名称【必备】-->
								<shootPoint>10,-25</shootPoint>		<!-- 射击点-->
								<type>太阳炮</type>					<!-- 武器类型【必备】-->
								<attackType>motion</attackType>		<!-- 攻击属性【必备】-->	
								<energyUse>0</energyUse>			<!-- 能量消耗【必备】 -->
								<description>利用能源转换器将太阳能转换成能量球发射出去。</description>
								
								<!-- 攻击时的属性-->
								<recoilValue>3</recoilValue>		<!-- 后坐力(默认为0)-->
								<attackGap>2.7</attackGap>			<!-- 攻击间隔【必备】（单位秒）-->
								<attackDelay>0.3</attackDelay>		<!-- 攻击前延迟（单位秒，默认值为0），这个值一定要小于攻击间隔，如果大于则攻击延迟直接等于攻击间隔-->	
								<bulletNum>1</bulletNum>				<!-- 射击一次的子弹数量（默认值为1），一般用于散射-->
								<shootNum>1</shootNum>				<!-- 1个攻击间隔内的射击次数（默认值为1）-->
								<!--<bulletLink index="2">subArms/missile_lv1</bulletLink>	 子弹链接，牛逼的功能，index就是你shoot在第几下的时候出现-->
								
								<!-- 发出子弹时的位置和角度、速度等属性	-->
								<bulletSpeed>35</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<angleRange>0</angleRange>			<!-- 散射角度（角度值，默认值为0），如果子弹数量>1，则在这个角度内均匀分布，否则抖动射击-->
								<!-- <bulletTranslation>0</bulletTranslation><!-- 子弹偏移（默认为0）-->
								<bulletAngle>0</bulletAngle>			<!--指定子弹发射角度，没有的话请删除这个属性。指定之后就不随炮口的旋转而改变方向了，但是如果炮口翻转，角度也会跟着翻转-->
								
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<hurt>1</hurt>								<!-- 武器伤害【必备】-->
								<bulletLife>2.6</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>7</bulletWidth>			<!-- 子弹宽度-->
								<penetrationB>1</penetrationB>
								<followB>1</followB>
								<followDelay>0.3</followDelay>
								<backTime>0.3</backTime>
								<gravity>-0.4</gravity>
								<!-- 图像动画-->
								<bulletImgLabel>ElectricSaw2/bullet</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
								<hitImgLabel>sub/cutter_hit_effect</hitImgLabel><!-- 子弹图像【必备】 -->
								<unitImgLabel>shoot_1</unitImgLabel><!-- 单位要播放的动画-->
							
				</armsLevel>
				<armsLevel>
								<name>空炮</name><!-- 武器名称【必备】-->
								<shootPoint>-1000,-80007</shootPoint>		<!-- 射击点-->
								<bulletSpeed>0</bulletSpeed>			<!-- 子弹速度，子弹类型为“bullet”才有这个值-->
								<bulletAngle>0</bulletAngle>
								<attackGap>0.6</attackGap>			<!-- 攻击间隔【必备】（单位秒）-->
								<!-- 子弹固有属性-->
								<bulletType>bullet</bulletType>		<!-- 子弹类型【必备】-->
								<bulletLife>0.01</bulletLife>					<!-- 子弹寿命（默认值为2）-->
								<bulletWidth>1</bulletWidth>			<!-- 子弹宽度-->
								<!-- 图像动画-->
								<bulletImgLabel>arms/Charger_bullet_1</bulletImgLabel><!-- 子弹图像（默认加后缀_bullet） -->
								<hitImgLabel>sub/boom_hit_effect</hitImgLabel><!-- 子弹碰撞效果【必备】 -->
								<unitImgLabel>shoot_2</unitImgLabel><!-- 单位要播放的动画-->
				</armsLevel>
	</arms>
	<arms index="10004"     id="Infiltrator2">
