								<position>450,0</position>
								<position>-450,0</position>
								<timeRange>1,1.6</timeRange>	
							</order>
							<order>
								<unit number="1" type="champion">拦截机2号</unit>
								<unit number="4">拦截机1号</unit>
								<position>450,0</position>
								<position>-450,0</position>
								<timeRange>1,1</timeRange>	
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy2">
							<order>
								<unit number="8">红蛛杀手</unit>
								<unit number="4">拦截机1号</unit>
