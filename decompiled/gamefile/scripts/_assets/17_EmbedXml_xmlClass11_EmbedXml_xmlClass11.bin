			<level  index="10" id="1-3-21" name="风暴熄灭">
						<enemyLv>65</enemyLv>
						<name>第九章  4.风暴熄灭</name>
						<!-- 场景id名称，存在scene.xml里-->
						<father>scene_alien</father>
						<scene>alien2</scene>
						<loopMusic>Junkyard_Tribe</loopMusic>
						
						<!-- boss设定-->
						<boss>
							<life>80000000,120000000,160000000,240000000</life><!-- 每个难度的血量-->
							<attackHurt>200000,2000000,100000</attackHurt><!-- 每个攻击的攻击伤害-->
						</boss>
						<!-- 剧情；--> 
						<storyOrder2>
							<!-- 
							--------------------------------------------------
							trigger触发条件
									"show:boss"		就是boss出现的时候触发
									"die:boss"		boss死亡时触发
									"area:enemy1"	碰到id等于enemy1的area就触发 
									不填时			代表着上面一条命令结束后触发。
							--------------------------------------------------
							body目标
							--------------------------------------------------
							action目标执行的动作	
									"say:这里全是我的！"		说对应的话
									"order:stopAttack"			目标停止攻击
									"order:stopAttack,middle"	目标停止攻击，接着跑到屏幕中间。一般boss出现时，在屏幕外，所以需要一个middle来让他跑到屏幕中间。
									"order:startAttack"			目标继续攻击
									"order:stopDie"				目标停止死亡
									"order:die"					目标死亡
							--------------------------------------------------
							overTime结束时间
									不填时			则默认是5，如果前面action是对话，则会根据对话字数进行匹配。
							--------------------------------------------------
							-->
							<story trigger="show:boss" body="boss" action="order:stopAttack,middle" overTime="2" />
							<story body="hero" action="say:这里全是我的！"/>
							<story body="boss" action="say:这里全是我的！哈哈！"/>
