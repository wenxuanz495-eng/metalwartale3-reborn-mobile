	<level  index="10" id="1-4-18" name="断其后路" scene="base3">
						<enemyLv>89</enemyLv>
						<name>第十章  19.断其后路</name>
						<father>scene_base</father>
						<scene>base3</scene>					<!-- 场景id名称，存在scene.xml里-->
						<loopMusic>Smash_Sketch</loopMusic>
						
						<!-- boss设定-->
						<boss>
							<life>20000000,30000000,40000000,50000000</life><!-- 每个难度的血量-->
						</boss>
						<!-- 剧情；--> 
						<storyOrder2>
							<!-- 
							--------------------------------------------------
							trigger触发条件
									"show:boss"		就是boss出现的时候触发
									"die:boss"		boss死亡时触发
									"area:enemy1"	碰到id等于enemy1的area就触发 
									不填时			代表着上面一条命令结束后触发。
							--------------------------------------------------
							body目标
							--------------------------------------------------
							action目标执行的动作	
									"say:这里全是我的！"		说对应的话
									"order:stopAttack"			目标停止攻击
									"order:stopAttack,middle"	目标停止攻击，接着跑到屏幕中间。一般boss出现时，在屏幕外，所以需要一个middle来让他跑到屏幕中间。
									"order:startAttack"			目标继续攻击
									"order:stopDie"				目标停止死亡
									"order:die"					目标死亡
							--------------------------------------------------
							overTime结束时间
									不填时			则默认是5，如果前面action是对话，则会根据对话字数进行匹配。
							--------------------------------------------------
							-->
							<story trigger="area:enemy1" body="hero" action="say:那是什么，那个阴影。" overTime="5" />
							
							<story trigger="show:boss" body="boss" action="order:stopAttack,middle" overTime="5" />
							<story body="boss" action="say:登陆成功，开始执行下一个指令。"/>
							<story body="boss" action="say:指令已接受，检测到有机生命体，开始执行清除命令。"/>
							<story body="boss" action="say:战斗开始，启动第一战斗模式。"/>	
							<story body="boss" action="order:startAttack"/>
							
							<story trigger="die:boss" body="boss" action="order:stopDie" overTime="5" />
							<story body="boss" action="say:电路破坏程度99%，已丧失战斗能力，开始上传战斗数据。"/>
							<story body="boss" action="say:上传完毕，启动自毁程序。"/>
							<story body="boss" action="say:3"/>
							<story body="boss" action="say:2"/>
							<story body="boss" action="say:1"/>
							<story body="boss" action="order:die"/>
							<story body="hero" action="say:它究竟上传了什么数据？"/>	
							
						</storyOrder2>
						
						<bornPoint>456,450</bornPoint>				<!-- 出生点-->
						<exitPoint>10800,450</exitPoint>				<!-- 终点-->
						
						<area id="enemy1">1250,390</area>
						<area id="enemy2">2250,390</area> 
						<area id="enemy1">3250,390</area> 

						<area id="enemy2">5000,390</area> 
						<area id="enemy1">6000,390</area>
						<area id="enemy2">7000,390</area> 
						
						<area id="enemy1">8800,390</area> 
						<area id="enemy3">9800,390</area>
						
				
						<area id="tip1">600,390</area>
						
