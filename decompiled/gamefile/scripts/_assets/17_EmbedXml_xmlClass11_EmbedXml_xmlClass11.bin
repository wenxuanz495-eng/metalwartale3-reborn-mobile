							<order>
							    <unit number="6">红色破袭者</unit>
							    <unit number="12">悬浮A1机器人</unit>
								<unit number="12">悬浮A2机器人</unit>
								<unit number="6">拦截机2号</unit>
							    <position>450,0</position>
							    <position>-450,0</position>
							    <timeRange>0,1.6</timeRange>	
