	<level  index="10" id="1-4-2"  name="声东击西" scene="mothership_ghost">
						<enemyLv>73</enemyLv>
						<name>第十章  3.声东击西</name>
						<father>scene_mothership</father>
						<scene>mothership_ghost</scene>					<!-- 场景id名称，存在scene.xml里-->
						<loopMusic>Smash_Sketch</loopMusic>
						
						<!-- boss设定-->
						<boss>
							<life>36000000,54000000,72000000,80000000</life><!-- 每个难度的血量-->
						</boss>
						<!-- 剧情；--> 
						<storyOrder2>
							<!-- 
							--------------------------------------------------
							trigger触发条件
									"show:boss"		就是boss出现的时候触发
									"die:boss"		boss死亡时触发
									"area:enemy1"	碰到id等于enemy1的area就触发 
									不填时			代表着上面一条命令结束后触发。
							--------------------------------------------------
							body目标
							--------------------------------------------------
							action目标执行的动作	
									"say:这里全是我的！"		说对应的话
									"order:stopAttack"			目标停止攻击
									"order:stopAttack,middle"	目标停止攻击，接着跑到屏幕中间。一般boss出现时，在屏幕外，所以需要一个middle来让他跑到屏幕中间。
									"order:startAttack"			目标继续攻击
									"order:stopDie"				目标停止死亡
									"order:die"					目标死亡
							--------------------------------------------------
							overTime结束时间
									不填时			则默认是5，如果前面action是对话，则会根据对话字数进行匹配。
							--------------------------------------------------
							-->
							<story trigger="show:boss" body="boss" action="order:stopAttack,middle" overTime="5" />
							<story body="boss" action="say:太迟了，人类。大天使已经降临，准备面对死亡吧。"/>
							<story body="hero" action="say:无论来的是什么，谁都别想从我的防线上这里过去。"/>
							<story body="boss" action="say:很好，那就让我来摧毁你的自信。"/>	
							<story body="boss" action="order:startAttack"/>
							
							<story trigger="die:boss" body="boss" action="order:stopDie" overTime="5" />
							<story body="hero" action="say:就这样，难道这就是你的全部实力！"/>
							<story body="boss" action="say:别高兴的太早，大天使会替我摧毁你们的。"/>
							<story body="boss" action="order:die"/>
							<story body="hero" action="say:大天使？看来我们有更大的问题了"/>	
							
						</storyOrder2>
						
						<bornPoint>456,400</bornPoint>				<!-- 出生点-->
						<exitPoint>5300,400</exitPoint>				<!-- 终点-->
						
						<area id="tip1">600,390</area>
						<area id="enemy1">1250,390</area>  <!--  事件区域点，如果只有2个值就是点，4个代表矩形；--> 
						<area id="enemy2">2150,390</area> 
						<area id="enemy1">3550,390</area> 
						<area id="enemy3">4500,390</area> 

						
						<oneEvent index="1" id="tip1">	
							<order>
								<unit number="1">文字：我们中计了，机器人的主攻部队已经突破了我们的防线，现在他们已经前进到主控室的外围，必须立刻支援他们。</unit>
								<position>450,0</position>
								<timeRange>1,5</timeRange>				<!-- 发兵时间区间（秒），从命令开始时计时，是个相对时间-->
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy1">
							<order>
								<unit number="8">红蛛杀手</unit>
								<unit number="4">拦截机1号</unit>
