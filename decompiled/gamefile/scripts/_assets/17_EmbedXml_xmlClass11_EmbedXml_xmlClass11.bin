	<level  index="10" id="1-4-9"  name="主动出击" scene="alien">
						<enemyLv>80</enemyLv>
						<name>第十章  10.主动出击</name>
						<father>scene_alien</father>
						<scene>alien</scene>					<!-- 场景id名称，存在scene.xml里-->
						<loopMusic>Smash_Sketch</loopMusic>
						
						<!-- boss设定-->
						<boss>
							<life>162000000,243000000,405000000,648000000</life><!-- 每个难度的血量-->
						</boss>
						<!-- 剧情；--> 
						<storyOrder2>
							<!-- 
							--------------------------------------------------
							trigger触发条件
									"show:boss"		就是boss出现的时候触发
									"die:boss"		boss死亡时触发
									"area:enemy1"	碰到id等于enemy1的area就触发 
									不填时			代表着上面一条命令结束后触发。
							--------------------------------------------------
							body目标
							--------------------------------------------------
							action目标执行的动作	
									"say:这里全是我的！"		说对应的话
									"order:stopAttack"			目标停止攻击
									"order:stopAttack,middle"	目标停止攻击，接着跑到屏幕中间。一般boss出现时，在屏幕外，所以需要一个middle来让他跑到屏幕中间。
									"order:startAttack"			目标继续攻击
									"order:stopDie"				目标停止死亡
									"order:die"					目标死亡
							--------------------------------------------------
							overTime结束时间
									不填时			则默认是5，如果前面action是对话，则会根据对话字数进行匹配。
							--------------------------------------------------
							-->
							<story trigger="area:enemy1" body="hero" action="say:那是什么，那个阴影。" overTime="5" />
							
							<story trigger="show:boss" body="boss" action="order:stopAttack,middle" overTime="5" />
							<story body="boss" action="say:登陆成功，开始执行下一个指令。"/>
							<story body="boss" action="say:指令已接受，检测到有机生命体，开始执行清除命令。"/>
							<story body="boss" action="say:战斗开始，启动第一战斗模式。"/>	
							<story body="boss" action="order:startAttack"/>
							
							<story trigger="die:boss" body="boss" action="order:stopDie" overTime="5" />
							<story body="boss" action="say:电路破坏程度99%，已丧失战斗能力，开始上传战斗数据。"/>
							<story body="boss" action="say:上传完毕，启动自毁程序。"/>
							<story body="boss" action="say:3"/>
							<story body="boss" action="say:2"/>
							<story body="boss" action="say:1"/>
							<story body="boss" action="order:die"/>
							<story body="hero" action="say:它究竟上传了什么数据？"/>		
						</storyOrder2>
						
						<bornPoint>1000,450</bornPoint>				<!-- 出生点-->
						<exitPoint>11000,450</exitPoint>					<!-- 终点-->
						
						<area id="enemy1">1600,390</area> 
						<area id="enemy2">2800,390</area> 
						<area id="enemy3">4000,390</area>
						<area id="enemy1">5200,390</area> 
						<area id="enemy2">6400,390</area> 
						<area id="enemy3">7600,390</area>
						<area id="enemy3">8800,390</area> 
						<area id="enemy4">10000,390</area> 
						

						<area id="tip1">1200,390</area>

						<oneEvent index="1" id="tip1">	
							<order>
								<unit number="1">文字：我们成功的守住了阵地，但是敌人的进攻绝不会停止。我们主动出击，在敌人再次组织进攻之前击破他们。</unit>
								<position>450,0</position>
								<timeRange>1,5</timeRange>				<!-- 发兵时间区间（秒），从命令开始时计时，是个相对时间-->
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy1">
							<order>
							    <unit number="8">红蛛杀手</unit>
							    <unit number="8">空袭战机</unit>
							    <position>450,0</position>
							    <position>-450,0</position>
							    <timeRange>0,1.6</timeRange>	
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy2">
							<order>
							    <unit number="8">红色破袭者</unit>
							    <unit number="4">拦截机1号</unit>
								<unit number="4">拦截机2号</unit>
							    <position>450,0</position>
							    <position>-450,0</position>
							    <timeRange>0,1.6</timeRange>	
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy3">
							<order>
							    <unit number="10">红色破袭者</unit>
							    <unit number="6">月面观察者</unit>
							    <position>450,0</position>
							    <position>-450,0</position>
							    <timeRange>0,1.6</timeRange>	
							</order>
						</oneEvent>
						<oneEvent index="1" id="enemy4">
							<order>
								<unit number="1" type="boss">战虎掠夺者</unit>
								<position>450,0</position>
								<position>-450,0</position>
								<timeRange>0,0.5</timeRange>	
							</order>
						</oneEvent>
			</level>
