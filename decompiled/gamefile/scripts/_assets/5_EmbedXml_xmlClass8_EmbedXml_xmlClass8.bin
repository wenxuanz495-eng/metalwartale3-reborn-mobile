		<enemy index="4"     id="ElectricSaw">             <!--电锯机器人-->
						<name>电锯机器人</name>
						<imgList>stand,move,attack,die</imgList>
						<hitRect>-35,-42,70,42</hitRect>
						<hurtRect>-22,-45,60,16</hurtRect>
						<hurtRect>-36,-26,73,26</hurtRect>
						
						<levelGrow>0,5,30</levelGrow>
						<baseLife>0.4</baseLife>
						<baseExp>1</baseExp>
						<baseCoin>1</baseCoin>
						<defenceType>motion</defenceType>
						<description>利用加特林机动原理的高射速车载型重炮，装填弹药为小型穿甲弹。</description>
						<!-- 以下是运动属性-->
						<vx>100</vx>															<!-- 速度x-->
						<vx>150</vx>
						<vx>150</vx>
						<vx>200</vx>
						<vx>200</vx>
						<vy>600</vy>															<!-- 速度y-->
						<tweenValue>0.1</tweenValue>								<!-- 缓动系数，【0】无缓动，【1】有缓动-->
						<jumpHeight>600</jumpHeight>									<!-- 弹跳高度-->
						<jumpNum>1</jumpNum>										<!-- 弹跳次数-->
						<!-- 以下是攻击属性-->
						<attackDelay>0.5</attackDelay>								<!-- 攻击前延迟-->
						<attackDelay>0.3</attackDelay>
						<attackDelay>0.1</attackDelay>
						<attackDelay>0</attackDelay>
						<grapRect>-80,-30,160,70</grapRect>						<!-- 误差矩形-->
						<hoverRect>-148,-80,93,83</hoverRect>
						<affterAttack>hoverAndAttack</affterAttack>				<!--  攻击一次之后做什么-->
						<nextAttackTime>2</nextAttackTime>						<!-- 下一次攻击时间间隔（单位秒）-->
						<nextAttackTime>1.6</nextAttackTime>
						<nextAttackTime>1.2</nextAttackTime>
						<nextAttackTime>0.8</nextAttackTime>
						<nextAttackTime>0.4</nextAttackTime>
						<nextAttackTime>0</nextAttackTime>
						<!-- 以下是攻击碰撞区域-->
						<attackHitData>
							<data label="attack" frame="6" endFrame="6">
									<hurt>0.66</hurt>								<!-- 武器伤害【必备】-->
														<!-- 等级成长系数-->
									<attackType>motion</attackType>		<!-- 攻击属性【必备】-->
									<recoilValue>2</recoilValue>			<!-- 后坐力(默认为0)-->
									<hitImgLabel>sub/cutter_hit_effect</hitImgLabel><!-- 子弹图像【必备】 -->
									<hitRect>1,-45,54,14</hitRect>
							</data>
						</attackHitData>
		</enemy>
