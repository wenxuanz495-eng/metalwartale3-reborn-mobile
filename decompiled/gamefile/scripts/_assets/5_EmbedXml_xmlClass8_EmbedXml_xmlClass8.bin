<?xml version="1.0" encoding="utf-8" ?>
<data>
		<enemy index="0"     id="AirLaserFort">            <!--悬浮自动激光炮台-->
						<name>悬浮自动激光炮台</name>
						<imgList>fly,shoot,die</imgList>
						<hitRect>-18,-11,36,18</hitRect>
						<hurtRect>-18,-11,36,18</hurtRect>
						
						<levelGrow>0,5,30</levelGrow>						<!-- 等级成长系数[生命,经验,金币掉落]-->
						<baseLife>0.2</baseLife>
						<baseExp>1</baseExp>
						<baseCoin>1</baseCoin>
						<defenceType>energy</defenceType>
						<description>利用加特林机动原理的高射速车载型重炮，装填弹药为小型穿甲弹。</description>
						<!-- 以下是运动属性-->
						<airRange>-400,-600</airRange>								<!-- 出现时的空中高度范围，一般用于飞行单位-->
							
						<vx>150</vx>															<!-- 速度x-->
						<vx>180</vx>
						<vx>210</vx>
						<vx>240</vx>
						<vx>270</vx>
						<vx>300</vx>
						<vy>150</vy>															<!-- 速度y-->
						<tweenValue>1</tweenValue>									<!-- 缓动系数-->
						<!-- 以下是攻击属性-->
						<attackDelay>0.5</attackDelay>								<!-- 攻击前延迟-->
						<grapRect>-80,-340,160,200</grapRect>						<!-- 误差矩形-->
						
						<affterAttack>followAndAttack</affterAttack>				<!--  攻击一次之后做什么-->
						<nextAttackTime>3</nextAttackTime>						<!-- 下一次攻击时间间隔（单位秒）-->
						<nextAttackTime>2.5</nextAttackTime>
						<nextAttackTime>2</nextAttackTime>
						<nextAttackTime>1.5</nextAttackTime>
						<nextAttackTime>1</nextAttackTime>
						<nextAttackTime>0</nextAttackTime>
		</enemy>
